<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <!-- PHASE 0: single canonical connection string. DbHelper reads this first,
         falls back to the default below when config is unavailable (e.g. unit tests). -->
    <connectionStrings>
        <add name="CanteenDb" connectionString="Server=localhost;Database=school_canteen_db;Uid=root;Pwd=;Connection Timeout=5;" providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>